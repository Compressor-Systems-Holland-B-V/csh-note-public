#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
project="${BWS_PROJECT_ID:-da0d011e-424f-44eb-a9d1-b4b001437287}"

stop() {
  echo "generate_icon: $1" >&2
  exit 1
}

command -v uv >/dev/null 2>&1 || stop "the 'uv' CLI is not installed."

run=(uv run --script "$root/tools/icon/generate.py" "$@")

if [[ -n "${RECRAFT_API_KEY:-}" || " $* " =~ \ (--dry-run|-h|--help)\  ]]; then
  exec "${run[@]}"
fi

command -v bws >/dev/null 2>&1 || stop "the 'bws' CLI is not installed."

bws run --project-id "$project" -- "${run[@]}"
